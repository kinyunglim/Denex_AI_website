# ==============================================================================
# client-starter environment. Copy to .env.local (or let `yarn client:init`
# generate it). On Vercel, add the same keys under Project → Settings → Env.
# Never commit real values.
# ==============================================================================

# --- core (required) ----------------------------------------------------------
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=client_slug
JWT_SECRET=change-me-64-hex-chars
JWT_ADMIN_SECRET=change-me-64-hex-chars
NEXT_PUBLIC_SITE_URL=https://www.client-domain.com

# Dev only: allows admin/admin login. Ignored when NODE_ENV=production.
DEFAULT_ADMIN=true

# --- email (admin login codes + enquiry notifications) ------------------------
# Without SMTP_HOST, emails are printed to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Business Name <noreply@client-domain.com>"

# --- module: stripe -----------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- module: gcal -------------------------------------------------------------
# Service-account JSON on ONE line; share the calendar with its client_email.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=

# --- preview deployments only (agency showcase) -------------------------------
# PREVIEW_MODE=1
# PREVIEW_THEME=warm
# NEXT_PUBLIC_AGENCY_ORDER_URL=https://agency.example.com/order
